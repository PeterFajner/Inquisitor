{
  "name": "inquisitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.ts",
    "start": "node dist/src/server.js",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "typecheck": "tsc && tsc -p src/client",
    "build": "tsc -p tsconfig.build.json && node --disable-warning=ExperimentalWarning scripts/client.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "rules:check": "node --disable-warning=ExperimentalWarning scripts/rules-check.ts",
    "simulate": "node --disable-warning=ExperimentalWarning scripts/simulate.ts",
    "heights:check": "node --disable-warning=ExperimentalWarning scripts/heights-check.ts",
    "fonts:metrics": "node --disable-warning=ExperimentalWarning scripts/font-metrics.ts"
  },
  "dependencies": {
    "@passwordless-id/webauthn": "2.4.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "docx-templates": "4.15.0",
    "esbuild": "0.28.2",
    "lucide-preact": "1.68.0",
    "preact": "11.2.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
